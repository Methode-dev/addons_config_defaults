<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_first_login_good_practice_form" model="ir.ui.view">
        <field name="name">first.login.good.practice.form</field>
        <field name="model">first.login.good.practice</field>
        <field name="arch" type="xml">
            <form string="Première connexion" class="o_first_login_good_practice_form">
                <p class="mb-2">
                    Pour votre sécurité, changez votre mot de passe et activez la
                    double authentification.
                </p>
                <group string="Nouveau mot de passe" col="3">
                    <group>
                        <field name="current_password" password="True"
                               string="Mot de passe actuel"/>
                    </group>
                    <group>
                        <field name="new_password" password="True"
                               string="Nouveau mot de passe"/>
                    </group>
                    <group>
                        <field name="confirm_password" password="True"
                               string="Confirmer le mot de passe"/>
                    </group>
                </group>
                <group string="Double authentification">
                    <p colspan="2" class="mb-2">
                        Scannez ce QR code ou saisissez la clé manuellement, puis
                        indiquez le code à 6 chiffres affiché par l'application.
                    </p>
                </group>
                <div class="d-flex align-items-center gap-4">
                    <field name="totp_qrcode" widget="image"
                           options="{'size': [104, 104]}" nolabel="1"
                           class="flex-shrink-0"/>
                    <group class="flex-grow-1 mb-0">
                        <field name="totp_secret_display"/>
                        <field name="totp_code" string="Code de vérification"/>
                    </group>
                </div>
                <field name="totp_wizard_id" invisible="1"/>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirmer" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_first_login_good_practice" model="ir.actions.act_window">
        <field name="name">Première connexion</field>
        <field name="res_model">first.login.good.practice</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_first_login_good_practice_form"/>
        <field name="target">new</field>
    </record>
</odoo>
